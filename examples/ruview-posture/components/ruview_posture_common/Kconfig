menu "RuView posture common settings"

config RVP_NODE_ID
    int "Logical node identifier"
    range 1 255
    default 1

config RVP_LED_ENABLE
    bool "Enable the WS2812 identity LED"
    default y

config RVP_LED_GPIO
    int "WS2812 identity LED GPIO"
    depends on RVP_LED_ENABLE
    default 48

config RVP_BUILD_ID
    string "Firmware build identifier"
    default "dev-unverified"

config RVP_PROBE_RATE_HZ
    int "Controlled probe frequency"
    range 50 100
    default 100

endmenu
